# Requerido: agente único de riesgos conectado a GESTITEL.
GROQ_API_KEY=tu_clave_aqui
PORT=5000
# Optional backup. Only activated after a transient Groq failure.
# Use a key you are authorized to use. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# GESTITEL: contexto operativo y matriz; conector del agente de solo lectura.
GESTITEL_USERNAME=
GESTITEL_PASSWORD=
